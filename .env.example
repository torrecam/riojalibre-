# ---------------------------------------------------------------------------
# Rioja Abierta · variables de entorno
# Copia este fichero a .env.local (desarrollo) y rellena los valores.
# ---------------------------------------------------------------------------

# Cadena de conexión Postgres. Es la que usan la web (lectura) y el ETL (escritura).
# En Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
#   postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# En local:
DATABASE_URL=postgres://postgres@localhost:5432/riojaabierta

# Supabase (opcionales hoy; reservadas para el panel de administración con Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Secreta! Solo en GitHub Actions / servidor, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para que el workflow de ingesta refresque la caché de la web (POST /api/revalidar)
REVALIDATE_SECRET=

# ---- Ajustes del ETL (opcionales) ----
# Regiones BDNS: 20 = ES230 La Rioja (NUTS-3). Añade 19 (ES23, NUTS-2) para ampliar (≈150.000 concesiones).
BDNS_REGIONES=20
# Umbral mínimo (€) para importar contratos menores
UMBRAL_MENORES=500
# Primer mes (AAAAMM) del histórico PLACE en la carga inicial (cada mes ≈ 200 MB de ZIP)
PLACE_DESDE_MES=202401
# Carpeta temporal de descargas del ETL
ETL_CACHE_DIR=./data
